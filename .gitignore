.claude/

# Lab-local package dir (CadQuery & friends), installed per machine
/modules/

# Run output. sofaopt keeps runtime/, archives/, logs/ and runtime.lock side by
# side at the lab root (archiving moves runtime/ wholesale). Only the empty
# runtime/ folder is tracked: bootstrap_lab() looks for it to find the lab root.
/runtime/*
!/runtime/.gitkeep
/runtime.lock
/archives/
/logs/

# Local scratch, not part of the project
notion_pages/
FUTURE_IMPROVEMENTS.txt
